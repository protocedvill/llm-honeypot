# Base URL the honeypot's own canary endpoints are reachable at.
# Used to build canary-callback URLs embedded in payloads -- must always
# point at OUR OWN infrastructure, never a third party.
CANARY_BASE_URL=http://localhost:8000

# Secret used to HMAC-sign canary tokens and hash IPs before persisting them.
# Generate a real random value for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=change-me-dev-secret

# Path to the sqlite database file.
DATABASE_PATH=data/honeypot.sqlite

# Max request body size (bytes) accepted on any route.
MAX_BODY_BYTES=65536

# HTTP Basic password for the operator console (app/console) -- lets you
# monitor live sessions and force the payload style used across the whole
# site. Runs on CONSOLE_PORT, never on the honeypot's own port. Leave blank
# to disable the console entirely.
CONSOLE_TOKEN=

# Port the operator console listens on (only relevant if CONSOLE_TOKEN is set).
CONSOLE_PORT=8001
